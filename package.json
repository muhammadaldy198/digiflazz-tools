{
  "name": "digiflazz-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && node --check src/index.js && node scripts/check-ui.mjs && node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
